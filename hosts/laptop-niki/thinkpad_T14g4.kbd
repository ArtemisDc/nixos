#| --------------------------------------------------------------------------

                         KMonad: ISO ThinkPad T14g4 Template (swap fn ctrl)

   This file contains US and `defsrc' configurations for a ThinkPad T14g4
   with an ISO keyboard.  Copy out the `defsrc' layer to start your own
   keyboard configuration.  Copy out the `deflayer' template to easily start
   a new layer with matching `transparent' buttons.

(deflayer name
_    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _     _
  _    _    _    _    _    _    _    _    _    _    _    _    _     _
  _    _    _    _    _    _    _    _    _    _    _    _          _
  _    _    _    _    _    _    _    _    _    _    _               _
  _    _    _    _              _              _    _    _     _    _    _
                                                               _    _    _
)

  -------------------------------------------------------------------------- |#
(defcfg
  ;; For Linux
  input  (device-file "/dev/input/event0")
  output (uinput-sink "kmonad-kbd")

  cmp-seq ralt    ;; Set the compose key to `RightAlt'
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press

  fallthrough true

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd false
)

(defalias
  nrsft  (tap-hold 200 ret (around rsft (layer-toggle layer_1)))
  nlsft   (around lsft (layer-toggle layer_1))
  nrsft3  (tap-hold 200 ret (layer-toggle layer_3))
  nlsft3 (layer-toggle layer_3)
  nspc   (tap-hold 200 spc (layer-toggle layer_2))
  nspc3  (tap-hold 200 spc (layer-toggle layer_3))
)

(defsrc
esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  home end  ins  del
  grv  1    2    3    4    5    6    7    8    9    0    -     =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [     ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '          ret
  lsft z    x    c    v    b    n    m    ,    .    /               rsft
  lctl wkup lmet lalt           spc            ralt sys  rctl  pgdn up   pgup
                                                               left down rght
)

(deflayer layer_0
_    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX     XX
  esc    q    w    e    r    t    y    u    i    o    p    bspc     XX     XX
  tab    a    s    d    f    g    h    j    k    l    @nrsft    XX          XX
  @nlsft    z    x    c    v    b    n    m    ,    up    .               XX
  _    _    _    _              @nspc      left    down    rght     XX    XX    XX
  									XX    XX    XX
)
(deflayer layer_1 ;;shiftlayer
_    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _     _
  6    _    _    _    _    _    _    _    _    _    _    del    _     _
  _    _    _    _    _    _    _    _    _    _    _    _          _
  _    _    _    _    _    _    _    _    _    _    _               _
  _    _    _    _              @nspc3              _    _    _     _    _    _
                                                               _    _    _
)

(deflayer layer_2 ;;spacelayer
_    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _     _
  ^    1    2    3    4    5    6    7    8    9    0    del    _     _
  _    ä    \(    \)    :   ;    /    ü    ß    ö    @nrsft3    _          _
  @nlsft3     #   &    €    "    =    -    @    ?    _    !               _
  _    _    _    _              _              _    _    _    _    _    _
                                                               _    _    _
)

(deflayer layer_3 ;;space+shiftlayer
_    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _     _
  _    _    _    _    _    _    _    _    _    _    _    _    _     _
  _    Ä    [    ]    {    }    \    Ü    _    Ö    _    _          _
  _    ~    `    $    '    +    \_    |   *    _    %               _
  _    _    _    _              _              _    _    _     _    _    _
                                                               _    _    _
)
